<Window
    x:Class="YoutubeMp3.Forms.UI.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="설정"
    Width="420"
    Height="200"
    Background="#1E1E1E"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YoutubeMp3.Forms;component/Themes/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  플레이어 화면으로 갈 때 창을 키울 높이  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#CCCCCC"
                Text="플레이어 화면 최소 높이" />

            <TextBox
                x:Name="PlayerHeightTextBox"
                Grid.Column="1"
                KeyDown="OnTextBoxKeyDown"
                Style="{StaticResource DarkTextBoxStyle}" />
        </Grid>

        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            FontSize="11"
            Foreground="#888888"
            Text="플레이어로 이동할 때 창이 이 높이보다 낮으면 여기까지 키웁니다(기본 800). 이미 더 크면 그대로 둡니다."
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Height="32"
                Click="OnCancelClick"
                Content="취소"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button
                Width="80"
                Height="32"
                Margin="8,0,0,0"
                Click="OnOkClick"
                Content="확인"
                IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
