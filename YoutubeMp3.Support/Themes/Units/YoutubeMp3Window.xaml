<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:units="clr-namespace:YoutubeMp3.Support.UI.Units">

    <Style TargetType="{x:Type units:YoutubeMp3Window}">
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome
                    CaptionHeight="36"
                    CornerRadius="0"
                    GlassFrameThickness="0"
                    NonClientFrameEdges="None"
                    ResizeBorderThickness="5"
                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:YoutubeMp3Window}">
                    <Border
                        x:Name="WindowBorder"
                        Background="#1E1E1E"
                        BorderBrush="#3C3C3C"
                        BorderThickness="1"
                        CornerRadius="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Title Bar  -->
                            <!--  바깥 테두리(1px) 안쪽이라 위 모서리는 2로 깎아야 둥근 테두리와 맞는다  -->
                            <Border
                                x:Name="TitleBarBackground"
                                Grid.Row="0"
                                Background="#2D2D2D"
                                CornerRadius="2,2,0,0" />
                            <Grid Grid.Row="0">
                                <!--  맨 왼쪽: 앱별 콘텐츠(설정 버튼 등) + 제목  -->
                                <StackPanel
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <ContentPresenter
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding TitleBarLeftContent}" />
                                    <TextBlock
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="#CCCCCC"
                                        Text="{TemplateBinding Title}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowTitleText, RelativeSource={RelativeSource AncestorType=units:YoutubeMp3Window}}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <!--  앱별 타이틀바 콘텐츠(가운데)  -->
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding TitleBarContent}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <!--  Minimize  -->
                                    <units:MinimizeButton x:Name="PART_MinimizeButton" />
                                    <!--  Maximize  -->
                                    <units:MaximizeButton x:Name="PART_MaximizeButton" />
                                    <!--  Close  -->
                                    <units:CloseButton x:Name="PART_CloseButton" />
                                </StackPanel>
                            </Grid>

                            <!--  Content Area  -->
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  최대화하면 화면 가장자리에 붙으므로 모서리를 각지게  -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="TitleBarBackground" Property="CornerRadius" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
