<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lr="clr-namespace:LazyRegion.WPF;assembly=LazyRegion.WPF"
    xmlns:support="clr-namespace:YoutubeMp3.Support.UI.Units;assembly=YoutubeMp3.Support"
    xmlns:views="clr-namespace:YoutubeMp3.Forms.UI.Views">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/YoutubeMp3.Forms;component/Themes/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource {x:Type support:YoutubeMp3Window}}" TargetType="{x:Type views:MainWindow}">
        <Setter Property="Title" Value="YoutubeMp3" />
        <Setter Property="Icon" Value="/YoutubeMp3.Forms;component/Resources/app.ico" />
        <Setter Property="Width" Value="800" />
        <Setter Property="Height" Value="600" />
        <Setter Property="MinWidth" Value="400" />
        <Setter Property="MinHeight" Value="300" />
        <Setter Property="WindowStyle" Value="None" />
        <!--  앱 이름·버전은 햄버거 메뉴 맨 위에 표시한다  -->
        <Setter Property="ShowTitleText" Value="False" />

        <!--  타이틀바 맨 왼쪽 햄버거 버튼 - 누르면 데시벨 조정·설정 메뉴가 열린다  -->
        <Setter Property="TitleBarLeftContent">
            <Setter.Value>
                <views:AppMenuButton Margin="6,0,0,0" VerticalAlignment="Center" />
            </Setter.Value>
        </Setter>

        <!--  타이틀바 가운데 내비게이션 버튼들 (각자 개별 화면으로 이동)  -->
        <Setter Property="TitleBarContent">
            <Setter.Value>
                <StackPanel Orientation="Horizontal">
                    <Button
                        Width="130"
                        Height="26"
                        VerticalAlignment="Center"
                        Command="{Binding ShowExtractionCommand}"
                        Content="Youtube Mp3 추출"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SecondaryButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExtractionActive}" Value="True">
                                        <Setter Property="Background" Value="#0078D4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!--  데시벨 조정은 왼쪽 햄버거 메뉴로 옮겼다  -->
                    <Button
                        Width="90"
                        Height="26"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding ShowPlayerCommand}"
                        Content="플레이어"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SecondaryButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlayerActive}" Value="True">
                                        <Setter Property="Background" Value="#0078D4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!--  폰으로 전송은 왼쪽 햄버거 메뉴로 옮겼다  -->
                    <!--  재생 조작: 플레이어 화면이 아니어도 쓸 수 있도록 타이틀바에 둔다  -->
                    <Button
                        Width="96"
                        Height="26"
                        Margin="24,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding Player.PlayPauseCommand}"
                        Content="{Binding Player.PlayPauseLabel}"
                        Style="{StaticResource AccentButtonStyle}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button
                        Width="72"
                        Height="26"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding Player.StopCommand}"
                        Content="■ 정지"
                        Style="{StaticResource SecondaryButtonStyle}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Setter.Value>
        </Setter>

        <!--  본문: LazyRegion으로 추출/데시벨 화면을 애니메이션 전환  -->
        <Setter Property="Content">
            <Setter.Value>
                <lr:LazyRegion
                    Margin="24"
                    Content="{Binding CurrentPage}"
                    TransitionAnimation="Fade" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
