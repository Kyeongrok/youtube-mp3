<Window
    x:Class="YoutubeMp3.Forms.UI.Views.PhoneTransferWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="휴대폰 전송"
    Width="320"
    Background="#1E1E1E"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow">
    <StackPanel Margin="16">
        <TextBlock
            x:Name="FileNameText"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="White"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />

        <Border
            Width="240"
            Height="240"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            Background="White">
            <Image
                x:Name="QrImage"
                Margin="8"
                Stretch="Uniform" />
        </Border>

        <TextBlock
            Margin="0,10,0,0"
            FontSize="12"
            Foreground="#CCCCCC"
            Text="같은 Wi-Fi의 휴대폰 카메라로 QR을 스캔하세요"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="UrlText"
            Margin="0,4,0,0"
            FontSize="11"
            Foreground="#4CC2FF"
            TextAlignment="Center"
            TextWrapping="Wrap" />
    </StackPanel>
</Window>
