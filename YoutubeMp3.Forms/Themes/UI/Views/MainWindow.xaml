<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lr="clr-namespace:LazyRegion.WPF;assembly=LazyRegion.WPF"
    xmlns:support="clr-namespace:YoutubeMp3.Support.UI.Units;assembly=YoutubeMp3.Support"
    xmlns:views="clr-namespace:YoutubeMp3.Forms.UI.Views">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/YoutubeMp3.Forms;component/Themes/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource {x:Type support:YoutubeMp3Window}}" TargetType="{x:Type views:MainWindow}">
        <Setter Property="Title" Value="YoutubeMp3" />
        <Setter Property="Icon" Value="/YoutubeMp3.Forms;component/Resources/app.ico" />
        <Setter Property="Width" Value="800" />
        <Setter Property="Height" Value="600" />
        <Setter Property="MinWidth" Value="400" />
        <!--  재생목록이 20곡은 보이도록 잡은 최소 높이  -->
        <Setter Property="MinHeight" Value="660" />
        <Setter Property="WindowStyle" Value="None" />
        <!--  앱 이름·버전(Title = "YoutubeMp3 vX.Y.Z", MainWindow.cs에서 설정)을 타이틀바의 햄버거 버튼 오른쪽에 표시한다  -->
        <Setter Property="ShowTitleText" Value="True" />

        <!--  타이틀바 맨 왼쪽 햄버거 버튼 - 누르면 데시벨 조정·설정 메뉴가 열린다  -->
        <Setter Property="TitleBarLeftContent">
            <Setter.Value>
                <views:AppMenuButton Margin="6,0,0,0" VerticalAlignment="Center" />
            </Setter.Value>
        </Setter>

        <!--  타이틀바 가운데: 어느 화면에서든 한 번에 옮겨 가는 탭(유튜브 MP3 추출 / 플레이어).
              나머지 화면 이동은 왼쪽 햄버거 메뉴에, 재생·정지는 플레이어 화면의 곡 제목 줄에 있다.  -->
        <Setter Property="TitleBarContent">
            <Setter.Value>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Width="100"
                        Height="26"
                        Command="{Binding ShowExtractionCommand}"
                        Content="YoutubeMp3"
                        ToolTip="유튜브 검색·MP3 추출 화면"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SecondaryButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExtractionActive}" Value="True">
                                        <Setter Property="Background" Value="#0078D4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        Width="90"
                        Height="26"
                        Margin="6,0,0,0"
                        Command="{Binding ShowPlayerCommand}"
                        Content="플레이어"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style BasedOn="{StaticResource SecondaryButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlayerActive}" Value="True">
                                        <Setter Property="Background" Value="#0078D4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Setter.Value>
        </Setter>

        <!--  본문: LazyRegion으로 추출/데시벨 화면을 애니메이션 전환  -->
        <Setter Property="Content">
            <Setter.Value>
                <lr:LazyRegion
                    Margin="24"
                    Content="{Binding CurrentPage}"
                    TransitionAnimation="Fade" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
