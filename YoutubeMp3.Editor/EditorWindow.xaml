<Window
    x:Class="YoutubeMp3.Editor.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:units="clr-namespace:YoutubeMp3.Editor.UI.Units"
    Title="{Binding FileName, StringFormat='노래 편집기 - {0}'}"
    Width="900"
    Height="480"
    MinWidth="640"
    MinHeight="360"
    Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  파일 열기 / 상태  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button
                Command="{Binding OpenFileCommand}"
                Content="파일 열기"
                DockPanel.Dock="Left" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#CCCCCC"
                Text="{Binding Status}"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!--  파형: 드래그로 구간 선택  -->
        <Border
            Grid.Row="1"
            BorderBrush="#3C3C3C"
            BorderThickness="1">
            <units:WaveformControl
                x:Name="PART_Waveform"
                Mode="{Binding WaveformMode}"
                Peaks="{Binding Peaks}"
                PlayPosition="{Binding PlayPositionSeconds, Mode=TwoWay}"
                ResetView="{Binding WaveformResetView}"
                SelectionEnd="{Binding EndSeconds, Mode=TwoWay}"
                SelectionStart="{Binding StartSeconds, Mode=TwoWay}"
                Duration="{Binding DurationSeconds}" />
        </Border>

        <!--  선택 구간 / 재생 위치 표시(분:초.소수 형식 — 84.47초는 "1:24.47"로 표시)  -->
        <DockPanel
            Grid.Row="2"
            Margin="0,8,0,8"
            LastChildFill="False">
            <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Foreground="#CCCCCC">
                <Run Text="선택 구간: " />
                <Run Text="{Binding StartTimeLabel, Mode=OneWay}" />
                <Run Text=" ~ " />
                <Run Text="{Binding EndTimeLabel, Mode=OneWay}" />
            </TextBlock>
            <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Foreground="#F2C04D">
                <Run Text="재생 위치: " />
                <Run Text="{Binding PlayPositionLabel, Mode=OneWay}" />
                <Run Text=" / " />
                <Run Text="{Binding DurationSeconds, Mode=OneWay, StringFormat={}{0:0.00}}" />
            </TextBlock>
        </DockPanel>

        <!--  재생 / 편집 버튼  -->
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Command="{Binding PlayPauseCommand}" Content="{Binding PlayPauseLabel}" />
            <Button Command="{Binding StopCommand}" Content="■ 정지" />
            <Separator Margin="4,0" />
            <Button Command="{Binding CutCommand}" Content="✂ 선택 구간 잘라내기" />
            <Button Command="{Binding UndoCommand}" Content="↶ 실행 취소" />
            <Separator Margin="4,0" />
            <Button
                Command="{Binding ExportCommand}"
                Content="💾 저장"
                FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
