<Window
    x:Class="YoutubeMp3.Forms.UI.Views.RenameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="파일명 변경"
    Width="420"
    Height="150"
    Background="#1E1E1E"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YoutubeMp3.Forms;component/Themes/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            FontSize="13"
            Foreground="#CCCCCC"
            Text="새 파일명(확장자 제외)을 입력하세요" />

        <TextBox
            x:Name="NameTextBox"
            Grid.Row="1"
            KeyDown="OnNameTextBoxKeyDown"
            Style="{StaticResource DarkTextBoxStyle}" />

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Height="32"
                Click="OnCancelClick"
                Content="취소"
                Style="{StaticResource SecondaryButtonStyle}" />
            <Button
                Width="80"
                Height="32"
                Margin="8,0,0,0"
                Click="OnOkClick"
                Content="확인"
                IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
